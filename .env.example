# Frontend Environment Variables
# Salin file ini menjadi .env.local lalu isi nilainya. Restart `npm run dev` setelah mengubah.

# URL backend Express (lokal: http://localhost:5000/api, production: https://xxx.onrender.com/api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ---- Kontak publik (tampil di website) ----
# Nomor WhatsApp admin (boleh 08xx / 628xx / +628xx)
NEXT_PUBLIC_WA_NUMBER=
# Username Telegram admin/bot tanpa @
NEXT_PUBLIC_TELEGRAM_USERNAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_OPENING_HOURS=Senin–Sabtu, 08.00–20.00
# Google Maps > Bagikan > Sematkan peta > salin nilai src="..."
NEXT_PUBLIC_MAPS_EMBED_URL=

# Notifikasi Telegram ke admin sekarang dikirim oleh backend
# (TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID diisi di backend/.env).
